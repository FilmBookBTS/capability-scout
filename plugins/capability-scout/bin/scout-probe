#!/usr/bin/env python3
"""Capability Scout read-only probe.

Wraps Claude Code's own inventory commands and prints a compact summary.
It never installs, enables, configures or writes settings. The only file it
writes is a cache of the marketplace catalog in owner-only storage
(lib/scout_store.py); a cache that is unsafe or malformed is ignored.
Side effect outside that storage: `search` runs `claude plugin list --available
--json`, which makes Claude Code create its own catalog caches in
~/.claude/plugins/ (plugin-catalog-cache.json; on newer versions also
plugin-directory-cache-v2.json) if they don't exist yet.
Note: `inventory` runs `claude mcp list`, whose health check starts each
configured stdio MCP server briefly. It changes no configuration.

Usage:
  scout-probe inventory            plugins, skills, MCP health (compact)
  scout-probe inventory --costs    also per-plugin always-on token estimate
  scout-probe search TERM [TERM..] rank uninstalled marketplace plugins
"""
import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True  # keep the plugin folder free of __pycache__
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import scout_store  # noqa: E402

CACHE_TTL_S = 6 * 3600


def run(args, timeout=60):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""


def plugins():
    code, out = run(["claude", "plugin", "list", "--json"])
    if code != 0:
        return None
    data = loads(out)
    if isinstance(data, dict):
        data = data.get("installed", [])
    return [p for p in data if isinstance(p, dict)] if isinstance(data, list) else None


def loads(text):
    try:
        return json.loads(text)
    except ValueError:
        return None


def plugin_skills(install_path):
    d = os.path.join(install_path or "", "skills")
    try:
        return sorted(n for n in os.listdir(d) if os.path.isfile(os.path.join(d, n, "SKILL.md")))
    except OSError:
        return []


def plugin_skill_list(install_path):
    names = plugin_skills(install_path)
    if not names and os.path.isfile(os.path.join(install_path or "", "SKILL.md")):
        names = ["(root SKILL.md)"]
    return names


MCP_LINE = re.compile(r"^(?P<name>[^:]+(?::[^:]+:[^:]+)?): (?P<target>.*?) - (?P<status>.*)$")


def mcp_health():
    code, out = run(["claude", "mcp", "list"], timeout=90)
    if code != 0:
        return None
    rows = []
    for line in out.splitlines():
        m = MCP_LINE.match(line.strip())
        if not m or "Checking MCP" in line:
            continue
        s = m.group("status")
        if "Connected" in s or "✓" in s:
            state = "ok"
        elif "Needs authentication" in s:
            state = "needs-auth"
        elif "Not configured" in s:
            state = "not-configured"
        elif "403" in s or "PROXY" in s:
            state = "blocked-by-network"
        elif "Pending approval" in s:
            state = "pending-approval"
        else:
            state = "failed"
        rows.append((m.group("name"), state))
    return rows


def always_on_tokens(plugin_id):
    code, out = run(["claude", "plugin", "details", plugin_id])
    m = re.search(r"Always-on:\s+~?([\d.,]+k?)\s*tok", out or "")
    return m.group(1) if m else "?"


def inventory(costs):
    out = {"scope": "execution-environment (this machine/container, via claude CLI)"}
    pl = plugins()
    if pl is None:
        out["plugins"] = "unavailable: claude CLI not found or failed"
    else:
        out["plugins"] = []
        for p in pl:
            row = {
                "id": p.get("id"),
                "enabled": p.get("enabled"),
                "scope": p.get("scope"),
                "skills": plugin_skill_list(p.get("installPath")),
            }
            if costs:
                row["always_on_tok"] = always_on_tokens(p.get("id"))
            out["plugins"].append(row)
    rows = mcp_health()
    if rows is None:
        out["mcp"] = "unavailable"
    else:
        summary = {}
        for name, state in rows:
            summary.setdefault(state, []).append(name)
        out["mcp"] = {k: (v if k == "ok" or len(v) <= 6 else v[:6] + [f"+{len(v) - 6} more"])
                      for k, v in summary.items()}
        out["mcp_counts"] = {k: len(v) for k, v in summary.items()}
    out["note"] = ("Session tool list in context is authoritative for what is callable now. "
                   "'loaded' plugins can still have failing MCP servers.")
    print(json.dumps(out, separators=(",", ":")))


def valid_catalog(c):
    return (isinstance(c, dict) and isinstance(c.get("installed"), list)
            and isinstance(c.get("available"), list)
            and all(isinstance(p, dict) and isinstance(p.get("id"), str) and isinstance(p.get("d"), str)
                    and isinstance(p.get("src"), str) for p in c["available"]))


def catalog():
    d = scout_store.private_dir()
    path = os.path.join(d, "catalog.json") if d else None
    if path:
        cached = scout_store.read_json(path, max_age_s=CACHE_TTL_S)
        if valid_catalog(cached):
            return cached, True
    code, out = run(["claude", "plugin", "list", "--available", "--json"], timeout=120)
    data = loads(out) if code == 0 else None
    if not isinstance(data, dict):
        return None, False
    slim = {
        "installed": [p.get("id") for p in data.get("installed", []) if isinstance(p, dict)],
        "available": [{"id": str(p.get("pluginId") or ""), "d": str(p.get("description") or "")[:300],
                       "src": str(p["source"].get("url") or "") if isinstance(p.get("source"), dict) else ""}
                      for p in data.get("available", []) if isinstance(p, dict) and p.get("pluginId")],
    }
    if path:
        scout_store.write_json(path, slim)
    return slim, False


FIRST_PARTY = ("github.com/anthropics/",)


def search(terms):
    cat, cached = catalog()
    if cat is None:
        print(json.dumps({"error": "marketplace listing unavailable (claude plugin list --available --json failed)"}))
        return
    terms = [t.lower() for t in terms if t.strip()]
    fresh = plugins()  # the cached installed list can be hours old
    installed = [p.get("id") for p in fresh] if fresh is not None else cat["installed"]
    hits = []
    for p in cat["available"]:
        if p["id"] in installed:
            continue
        name = p["id"].split("@")[0].lower()
        text = (name + " " + p["d"]).lower()
        score = sum(3 if t in name else 1 for t in terms if t in text)
        if score:
            fp = any(p["src"].startswith("https://" + x) for x in FIRST_PARTY)
            hits.append((score + (1 if fp else 0), p, fp))
    hits.sort(key=lambda h: -h[0])
    print(json.dumps({
        "scope": "marketplace (configured marketplaces only)",
        "catalog_size": len(cat["available"]),
        "from_cache": cached,
        "installed": installed,
        "top": [{"id": p["id"], "first_party": fp, "desc": p["d"][:160]} for _, p, fp in hits[:8]],
        "reminder": "Recommend only on material benefit. Never install; the user approves and installs.",
    }, separators=(",", ":")))


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[1] == "inventory":
        inventory("--costs" in argv[2:])
    elif argv[1] == "search" and len(argv) > 2:
        search(argv[2:])
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
