{
  "description": "Activation hook. On by default; set CAPABILITY_SCOUT_HOOK=off (or 0) to turn it off. PostToolUse on Skill confirms that an assessment actually ran.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scout-activate\"", "timeout": 5}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/scout-activate\" confirm", "timeout": 5}
        ]
      }
    ]
  }
}
